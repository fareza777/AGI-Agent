# Telegram bot token — talk to @BotFather on Telegram to create a bot (required)
TELEGRAM_BOT_TOKEN=123456789:AA...

# ---------- Provider option A: Anthropic (default, recommended) ----------
# https://platform.claude.com/
ANTHROPIC_API_KEY=sk-ant-...
# Model for chat replies (default: claude-opus-4-8)
#ENGRAM_CHAT_MODEL=claude-opus-4-8
# Model for background consolidation/reflection (default: same as chat model;
# set to claude-haiku-4-5 to cut background costs)
#ENGRAM_CONSOLIDATE_MODEL=claude-haiku-4-5

# ---------- Provider option B: OpenRouter ----------
# Uncomment these (and comment out ANTHROPIC_API_KEY above):
#ENGRAM_PROVIDER=openrouter
#OPENROUTER_API_KEY=sk-or-...
#ENGRAM_CHAT_MODEL=minimax/minimax-m2
#ENGRAM_CONSOLIDATE_MODEL=minimax/minimax-m2

# ---------- Provider option C: MiniMax direct ----------
#ENGRAM_PROVIDER=minimax
#MINIMAX_API_KEY=...
#ENGRAM_CHAT_MODEL=MiniMax-M2
# Base URL defaults to https://api.minimax.io/v1 — override if your account
# uses a different endpoint:
#ENGRAM_OPENAI_BASE_URL=https://api.minimax.io/v1

# ---------- Provider option D: any OpenAI-compatible endpoint ----------
#ENGRAM_PROVIDER=openai
#ENGRAM_LLM_API_KEY=...
#ENGRAM_OPENAI_BASE_URL=https://your-endpoint/v1
#ENGRAM_CHAT_MODEL=your-model-id
# Path to the SQLite database (default: ./engram.db)
#ENGRAM_DB_PATH=engram.db
# Minutes between background consolidation passes (default: 30)
#ENGRAM_CONSOLIDATE_INTERVAL_MIN=30
# Restrict the bot to specific Telegram chat IDs, comma-separated (default: open)
#ENGRAM_ALLOWED_CHAT_IDS=

# ---------- Digital-assistant / desktop ----------
# Workspace where the agent reads/writes files and saves generated documents
# (default: ./workspace). Generated files are sent back to you over Telegram.
#ENGRAM_WORKSPACE_DIR=workspace
# Extra directories the agent may read/inspect (e.g. your code repos), comma
# separated absolute paths. Default: only the workspace.
#ENGRAM_ALLOWED_DIRS=/home/you/projects,/home/you/Documents
# Enable the run_python tool (executes model-written code on this machine).
# Only enable if you trust everyone who can message the bot. (default: 0)
#ENGRAM_ENABLE_CODE_TOOL=0
# Enable the run_shell tool (runs shell commands in the workspace). Same trust
# caveat. (default: 0)
#ENGRAM_ENABLE_SHELL_TOOL=0
# Shell command timeout in seconds (default: 30)
#ENGRAM_SHELL_TIMEOUT_SEC=30
# Git tool mode:
#   1 = read-only (status, log, diff, branch, show, remote, ls-files, shortlog)
#   0 = write also allowed (add, commit, checkout, branch -d, stash, push, fetch)
# Blocked in BOTH modes: --force, --force-with-lease, reset --hard, clean -fd
# Default: 1 (read-only is the safe default; flip to 0 to let the agent commit/push)
#ENGRAM_GIT_READ_ONLY=1
# Live activity feed in chat ("🔎 web_search: ..." while the agent works).
# Set 0 to disable. (default: 1)
#ENGRAM_SHOW_ACTIVITY=1

# ---------- Optional capabilities (Sprint 2/3) ----------
# Context budget: hard ceiling on the assembled system prompt (~chars/4 tokens).
# Retrieved memory is trimmed to fit; static instructions are always kept.
#ENGRAM_MAX_CONTEXT_TOKENS=12000
# Brand logo placed on the cover of generated docx/pptx (default: bundled avatar).
#ENGRAM_BRAND_LOGO=/path/to/logo.png
# Voice notes: transcribe incoming Telegram voice via an OpenAI-compatible
# /audio/transcriptions endpoint. Unset = voice disabled (agent says so, never
# invents the audio's content).
#ENGRAM_STT_ENDPOINT=https://api.openai.com/v1
#ENGRAM_STT_API_KEY=sk-...
#ENGRAM_STT_MODEL=whisper-1
# Semantic memory: embeddings endpoint (OpenAI-compatible /embeddings). When set,
# claim search becomes hybrid (BM25 + cosine re-rank). Unset = pure BM25.
#ENGRAM_EMBED_ENDPOINT=https://api.openai.com/v1
#ENGRAM_EMBED_API_KEY=sk-...
#ENGRAM_EMBED_MODEL=text-embedding-3-small
# Outbound email (send_email tool). Unset = tool reports "not configured".
#ENGRAM_SMTP_HOST=smtp.gmail.com
#ENGRAM_SMTP_PORT=587
#ENGRAM_SMTP_USER=you@gmail.com
#ENGRAM_SMTP_PASSWORD=app-password
#ENGRAM_SMTP_FROM=you@gmail.com
# Image generation (generate_image tool). OpenAI-compatible /images/generations.
# Unset = tool reports "not configured".
#ENGRAM_IMAGE_ENDPOINT=https://api.openai.com/v1
#ENGRAM_IMAGE_API_KEY=sk-...
#ENGRAM_IMAGE_MODEL=gpt-image-1
