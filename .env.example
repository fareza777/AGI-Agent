# Anthropic API key — https://platform.claude.com/
ANTHROPIC_API_KEY=sk-ant-...

# Telegram bot token — talk to @BotFather on Telegram to create a bot
TELEGRAM_BOT_TOKEN=123456789:AA...

# Optional overrides
# Model used for chat replies (default: claude-opus-4-8)
#ENGRAM_CHAT_MODEL=claude-opus-4-8
# Model used for background consolidation/reflection (default: claude-opus-4-8;
# set to claude-haiku-4-5 to cut background costs)
#ENGRAM_CONSOLIDATE_MODEL=claude-opus-4-8
# Path to the SQLite database (default: ./engram.db)
#ENGRAM_DB_PATH=engram.db
# Minutes between background consolidation passes (default: 30)
#ENGRAM_CONSOLIDATE_INTERVAL_MIN=30
# Restrict the bot to specific Telegram chat IDs, comma-separated (default: open)
#ENGRAM_ALLOWED_CHAT_IDS=
